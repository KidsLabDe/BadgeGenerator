# API Key von https://aistudio.google.com/apikey
PB_GEMINI_API_KEY=

# Modelle (bei Bedarf anpassen)
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Druck: auto | brother_ql | cups | none
PRINT_MODE=auto
# Linux: BROTHER_QL_BACKEND=linux_kernel, BROTHER_QL_PRINTER=file:///dev/usb/lp0
# macOS: BROTHER_QL_BACKEND=pyusb,        BROTHER_QL_PRINTER=usb://0x04f9:0x2027
BROTHER_QL_CMD=brother_ql
BROTHER_QL_BACKEND=
BROTHER_QL_PRINTER=
CUPS_PRINTER=

PORT=5173
